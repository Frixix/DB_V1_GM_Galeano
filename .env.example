# Variables de Entorno del Cliente (Vite)
# Copia este archivo a .env.local y reemplaza con tus credenciales

VITE_SUPABASE_URL=https://tu-proyecto.supabase.co
VITE_SUPABASE_ANON_KEY=tu-anon-key-aqui

# Cloudflare R2
VITE_R2_ACCOUNT_ID=tu-account-id
VITE_R2_ACCESS_KEY_ID=tu-access-key-id
VITE_R2_SECRET_ACCESS_KEY=tu-secret-access-key
VITE_R2_BUCKET_NAME=documentos-galeano
VITE_R2_ENDPOINT=https://tu-account-id.r2.cloudflarestorage.com
