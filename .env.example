# ==============================================================================
# GIMNASIO MARTÍN GALEANO - PLANTILLA DE VARIABLES DE PRODUCCIÓN (Vite)
# ==============================================================================
# Instrucciones:
# 1. Copia este archivo como .env.local para desarrollo local, o configúralo en el panel
#    de variables de entorno de tu proveedor de hosting (Vercel, Cloudflare Pages, Netlify).
# 2. Reemplaza cada variable con los valores reales generados en producción.
# 3. NUNCA confirmes archivos .env o .env.local con credenciales reales en Git.
# ==============================================================================

# --- DOMINIO INSTITUCIONAL & PRODUCCIÓN ---
# URL base oficial de la aplicación (ej. https://sistema.gimnasiomartingaleano.edu.co)
VITE_APP_URL=https://sistema.gimnasiomartingaleano.edu.co

# --- SUPABASE (Base de Datos, Realtime & Autenticación) ---
# URL de la instancia de Supabase
VITE_SUPABASE_URL=https://tu-proyecto.supabase.co
# Llave pública anónima (anon public key)
VITE_SUPABASE_ANON_KEY=tu-anon-key-aqui
# Nombre del bucket de contingencia / fallback en Supabase Storage
VITE_SUPABASE_STORAGE_BUCKET=documentos-galeano

# --- CLOUDFLARE R2 (Almacenamiento Primario S3 Compatible) ---
# Cloudflare Account ID (32 caracteres hexadecimales)
VITE_R2_ACCOUNT_ID=tu-account-id
# R2 Access Key ID
VITE_R2_ACCESS_KEY_ID=tu-access-key-id
# R2 Secret Access Key
VITE_R2_SECRET_ACCESS_KEY=tu-secret-access-key
# Nombre del bucket en Cloudflare R2
VITE_R2_BUCKET_NAME=documentos-galeano
# Endpoint S3 de Cloudflare R2: https://<ACCOUNT_ID>.r2.cloudflarestorage.com
VITE_R2_ENDPOINT=https://tu-account-id.r2.cloudflarestorage.com
# Dominio público opcional o Custom Domain conectado al bucket R2
VITE_R2_PUBLIC_DOMAIN=https://pub-tu-subdominio.r2.dev
